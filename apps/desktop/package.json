{
  "name": "@whisperflow/desktop",
  "productName": "WhisperFlow",
  "version": "0.1.1",
  "private": true,
  "description": "WhisperFlow — open-source, local-first AI voice dictation (desktop app)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "package": "electron-vite build && electron-builder --win",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@whisperflow/engine": "*",
    "@whisperflow/shared": "*",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.61.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "zustand": "^5.0.8"
  },
  "author": {
    "name": "WhisperFlow contributors",
    "email": "whisperflow@naman.is-a.dev"
  }
}
