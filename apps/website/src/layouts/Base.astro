---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "WhisperFlow — your voice, rendered. Open-source, local-first dictation",
  description = "Hold a key, speak, get polished text in any app. whisper.cpp + llama.cpp run on your machine. No caps, no cloud, no telemetry. Apache-2.0.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        // v3: light (paper) is the default; only "dark" flips the print
        if (localStorage.getItem("wf-mode") === "dark") document.documentElement.dataset.mode = "dark";
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/whisperflow/favicon.svg" />
    <link rel="sitemap" href="/whisperflow/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WhisperFlow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- the scroll signal: phosphor progress line, instrument-style -->
    <div id="scroll-signal" aria-hidden="true"></div>
    <script is:inline>
      (function () {
        var bar = document.getElementById("scroll-signal");
        function paint() {
          if (!bar) return;
          var h = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.width = h > 0 ? (window.scrollY / h) * 100 + "%" : "0%";
        }
        window.addEventListener("scroll", paint, { passive: true });
        paint();
      })();
    </script>
    <!-- scroll reveals -->
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("revealed"); io.unobserve(e.target); }
          });
        }, { threshold: 0.08 });
        document.addEventListener("DOMContentLoaded", function () {
          document.querySelectorAll("section > div, .panel, details").forEach(function (el) {
            el.classList.add("reveal"); io.observe(el);
          });
        });
      })();
    </script>
    <!-- Lenis smooth scroll (marketing site only, reduced-motion aware) -->
    <script>
      import Lenis from "lenis";
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ duration: 0.9, wheelMultiplier: 0.9 });
        const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      }
    </script>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
