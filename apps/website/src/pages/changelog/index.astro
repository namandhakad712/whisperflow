---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Base from "../../layouts/Base.astro";

const raw = readFileSync(resolve(process.cwd(), "../../CHANGELOG.md"), "utf-8");

// minimal md → html (headings, lists, bold, links)
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const html = esc(raw)
  .replace(/^### (.*)$/gm, "<h3>$1</h3>")
  .replace(/^## (.*)$/gm, "<h2>$1</h2>")
  .replace(/^# (.*)$/gm, "<h1>$1</h1>")
  .replace(/^> (.*)$/gm, "<blockquote>$1</blockquote>")
  .replace(/^\- \[ \] (.*)$/gm, "<li>☐ $1</li>")
  .replace(/^\- \[x\] (.*)$/gim, "<li>☑ $1</li>")
  .replace(/^\- (.*)$/gm, "<li>$1</li>")
  .replace(/(<li>[\s\S]*?<\/li>)(?!\s*<li>)/g, "<ul>$1</ul>")
  .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
  .replace(/`([^`]+)`/g, "<code>$1</code>")
  .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---
<Base title="Changelog — WhisperFlow" description="Every notable WhisperFlow change, newest first.">
  <section class="border-b border-rule">
    <div class="mx-auto max-w-6xl px-5 pb-16 pt-28 sm:px-8 sm:pt-36">
      <p class="eyebrow">print history</p>
      <h1 class="font-serif mt-6 text-6xl font-normal leading-[0.98] text-ink sm:text-8xl">changelog<span class="text-accent">.</span></h1>
      <p class="mt-6 max-w-md text-[15px] leading-7 text-ink-2">
        every notable change, newest first. also on
        <a class="underline decoration-dotted underline-offset-4 hover:text-accent" href="https://github.com/namandhakad712/whisperflow/blob/main/CHANGELOG.md">github</a>.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8">
    <div class="changelog-body prose max-w-none" set:html={html} />
  </section>
</Base>
