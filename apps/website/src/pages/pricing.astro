---
import Base from "../layouts/Base.astro";
import SignalPanel from "../components/SignalPanel.astro";
---
<Base
  title="Pricing — WhisperFlow"
  description="WhisperFlow is free forever, unlimited, Apache-2.0. Not selling cloud yet — design the plan YOU would pay for and tell us."
>
  <script is:inline>
    function calc() {
      const words = +document.getElementById("words").value;
      const feats = [...document.querySelectorAll("input[name=feat]:checked")].length;
      const base = 0;
      const perFeat = 1.5;
      const unlimitedBoost = words > 90 ? 3 : 0;
      const total = Math.max(0, base + feats * perFeat + unlimitedBoost);
      document.getElementById("price").textContent = "$" + total;
      document.getElementById("wordsLabel").textContent =
        words <= 10 ? "5k words/mo" : words <= 40 ? "50k" : words <= 75 ? "250k" : words <= 90 ? "1M" : "Unlimited";
    }
    function mailtoPlan() {
      const words = document.getElementById("wordsLabel").textContent;
      const feats = [...document.querySelectorAll("input[name=feat]:checked")].map((f) => f.value).join(", ") || "none";
      const price = document.getElementById("price").textContent;
      const body = encodeURIComponent(
        `My ideal WhisperFlow plan:\n- Words: ${words}\n- Features: ${feats}\n- I would pay: ${price}/mo\n- (Optional) what would make it a no-brainer:\n`,
      );
      window.location.href = `mailto:whisperflow@naman.is-a.dev?subject=${encodeURIComponent("My ideal WhisperFlow plan")}&body=${body}`;
      document.getElementById("thanks").classList.remove("hidden");
    }
    document.addEventListener("change", calc);
    document.addEventListener("DOMContentLoaded", calc);
  </script>

  <section class="relative border-b border-line-soft">
    <div class="mx-auto max-w-6xl px-4 pt-24 text-center sm:px-6 sm:pt-32">
      <p class="sec-mark mx-auto">open-core, honestly</p>
      <h1 class="font-display mx-auto mt-7 max-w-3xl text-5xl font-bold leading-[1.03] tracking-[-0.045em] sm:text-7xl">
        we're not selling <span class="text-phosphor">anything</span> yet.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-ink-dim">
        whisperflow runs entirely on your machine with your models — so the core app is free,
        unlimited, forever. we might build hosted inference someday for weak hardware. we
        honestly haven't decided. <span class="text-ink">you tell us.</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="panel">
      <div class="panel-head">
        <span class="flex items-center gap-2.5">
          <span class="led" data-on="busy" aria-hidden="true"></span>
          <span class="mono-label text-ink-dim">plan calibrator</span>
        </span>
        <span class="font-mono text-[11px] text-ink-faint">zero tracking · just an email</span>
      </div>
      <div class="p-8 sm:p-10">
        <h2 class="font-display text-3xl font-bold tracking-[-0.04em]">design the plan <span class="text-phosphor">you'd</span> pay for</h2>
        <p class="mt-2 text-sm text-ink-dim">
          drag, tick, and see what it's worth to you. zero obligation — this literally just opens
          an email. no tracking, no accounts, no storage.
        </p>

        <p class="mono-label mt-8 text-ink-faint">words per month</p>
        <input id="words" type="range" min="0" max="100" value="100" class="mt-3 w-full accent-[#5CE1A9]" aria-label="Words per month" />
        <p class="mt-1 text-sm text-ink-dim"><span id="wordsLabel" class="font-mono font-medium text-ink">Unlimited</span></p>

        <p class="mono-label mt-6 text-ink-faint">features</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {[
            ["cloud-relay", "hosted models relay (no local setup)"],
            ["sync", "cross-device history sync"],
            ["team", "team dictionary & snippets sharing"],
            ["priority", "priority support"],
          ].map(([id, label]) => (
            <label class="flex cursor-pointer items-center gap-3 rounded-none border border-line bg-paper/60 px-4 py-3 text-sm transition-colors hover:border-phosphor/60">
              <input type="checkbox" name="feat" value={id} class="h-4 w-4 accent-[#5CE1A9]" />
              {label}
            </label>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-line-soft pt-6">
          <p class="font-display text-4xl"><span id="price" class="font-mono">$0</span><span class="text-base text-ink-dim">/mo</span></p>
          <button type="button" onclick="mailtoPlan()" class="btn btn-primary">send us this plan</button>
        </div>
        <p id="thanks" class="mt-3 hidden font-mono text-sm text-phosphor">[ok] your email app just opened — hit send and we'll read it.</p>
      </div>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <SignalPanel label="why free works" led="live">
        <div class="p-6">
          <p class="text-sm leading-6 text-ink-dim">
            models run on your machine; free api tiers (groq, gemini, openrouter…) cover byo
            polish for almost everyone. there's no server bill to pass on — so there's no price.
          </p>
        </div>
      </SignalPanel>
      <SignalPanel label="bring your own key" led="live">
        <div class="p-6">
          <p class="text-sm leading-6 text-ink-dim">
            any openai-compatible endpoint plugs into settings → style. your key stays in your
            local config. the local-only lock overrides everything when you want pure offline.
          </p>
        </div>
      </SignalPanel>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 text-center sm:px-6">
    <h2 class="font-display text-4xl font-bold tracking-[-0.04em] sm:text-5xl">
      meanwhile, it's <span class="text-phosphor">yours</span>.
    </h2>
    <div class="mt-8"><a href="/whisperflow/download/" class="btn btn-primary">download whisperflow</a></div>
  </section>
</Base>
