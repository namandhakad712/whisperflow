---
import Base from "../layouts/Base.astro";
---
<Base
  title="Pricing — WhisperFlow"
  description="WhisperFlow is free forever, unlimited, Apache-2.0. Not selling cloud yet — design the plan YOU would pay for and tell us."
>
  <script is:inline>
    function calc() {
      const words = +document.getElementById("words").value;
      const feats = [...document.querySelectorAll("input[name=feat]:checked")].length;
      const base = 0;
      const perFeat = 1.5;
      const unlimitedBoost = words > 90 ? 3 : 0;
      const total = Math.max(0, base + feats * perFeat + unlimitedBoost);
      document.getElementById("price").textContent = "$" + total;
      document.getElementById("wordsLabel").textContent =
        words <= 10 ? "5k words/mo" : words <= 40 ? "50k" : words <= 75 ? "250k" : words <= 90 ? "1M" : "Unlimited";
    }
    function mailtoPlan() {
      const words = document.getElementById("wordsLabel").textContent;
      const feats = [...document.querySelectorAll("input[name=feat]:checked")].map((f) => f.value).join(", ") || "none";
      const price = document.getElementById("price").textContent;
      const body = encodeURIComponent(
        `My ideal WhisperFlow plan:\n- Words: ${words}\n- Features: ${feats}\n- I would pay: ${price}/mo\n- (Optional) what would make it a no-brainer:\n`,
      );
      window.location.href = `mailto:whisperflow@users.noreply.github.com?subject=${encodeURIComponent("My ideal WhisperFlow plan")}&body=${body}`;
      document.getElementById("thanks").classList.remove("hidden");
    }
    document.addEventListener("change", calc);
    document.addEventListener("DOMContentLoaded", calc);
  </script>

  <section class="void-glow relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 pt-24 text-center sm:px-6 sm:pt-32">
      <p class="mx-auto inline-flex items-center gap-2 rounded-full border border-line bg-white/[0.03] px-4 py-1.5 font-mono text-[11px] tracking-[0.14em] text-ink-dim">
        <span class="h-1.5 w-1.5 rounded-full bg-[#4C6FFF] shadow-[0_0_10px_rgba(76,111,255,0.9)]"></span>
        FREE FOREVER · NO CAPS · NO ACCOUNT
      </p>
      <h1 class="font-display mx-auto mt-8 max-w-3xl text-5xl leading-[1.03] sm:text-7xl">
        We're not selling <em class="serif-em">anything</em> yet.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-ink-dim">
        WhisperFlow runs entirely on your machine with your models — so the core app is free,
        unlimited, forever. We might build hosted inference someday for weak hardware. We
        honestly haven't decided. <span class="text-ink">You tell us.</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="glass-panel p-8 sm:p-10">
      <h2 class="font-display text-3xl">Design the plan <em class="serif-em italic">you'd</em> pay for</h2>
      <p class="mt-2 text-sm text-ink-dim">
        Drag, tick, and see what it's worth to you. Zero obligation — this literally just opens
        an email. No tracking, no accounts, no storage.
      </p>

      <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.16em] text-ink-faint">Words per month</p>
      <input id="words" type="range" min="0" max="100" value="100" class="mt-3 w-full accent-[#2952E3]" aria-label="Words per month" />
      <p class="mt-1 text-sm text-ink-dim"><span id="wordsLabel" class="font-medium text-ink">Unlimited</span></p>

      <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.16em] text-ink-faint">Features</p>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        {[
          ["cloud-relay", "Hosted models relay (no local setup)"],
          ["sync", "Cross-device history sync"],
          ["team", "Team dictionary & snippets sharing"],
          ["priority", "Priority support"],
        ].map(([id, label]) => (
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line bg-white/[0.02] px-4 py-3 text-sm transition-colors hover:border-[#2952E3]/50">
            <input type="checkbox" name="feat" value={id} class="h-4 w-4 accent-[#2952E3]" />
            {label}
          </label>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
        <p class="font-display text-4xl"><span id="price">$0</span><span class="text-base text-ink-dim">/mo</span></p>
        <button type="button" onclick="mailtoPlan()" class="btn-primary">Send us this plan</button>
      </div>
      <p id="thanks" class="mt-3 hidden text-sm text-[#8FB0FF]">✓ Your email app just opened — hit send and we'll read it.</p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <div class="glass-panel p-7">
        <h3 class="font-display text-2xl italic">Why free works</h3>
        <p class="mt-3 text-sm leading-6 text-ink-dim">
          Models run on your machine; free API tiers (Groq, Gemini, OpenRouter…) cover BYO
          polish for almost everyone. There's no server bill to pass on — so there's no price.
        </p>
      </div>
      <div class="glass-panel p-7">
        <h3 class="font-display text-2xl italic">Bring your own key</h3>
        <p class="mt-3 text-sm leading-6 text-ink-dim">
          Any OpenAI-compatible endpoint plugs into Settings → Style. Your key stays in your
          local config. The local-only lock overrides everything when you want pure offline.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 text-center sm:px-6">
    <h2 class="font-display text-4xl sm:text-5xl">
      Meanwhile, it's <em class="serif-em">yours</em>.
    </h2>
    <div class="mt-8"><a href="/whisperflow/download/" class="btn-primary">Download WhisperFlow</a></div>
  </section>
</Base>
