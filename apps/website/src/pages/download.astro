---
import Base from "../layouts/Base.astro";
import SignalPanel from "../components/SignalPanel.astro";
---
<Base
  title="Download — WhisperFlow"
  description="Download WhisperFlow for Windows, or build from source. Free, open-source, Apache-2.0."
>
  <section class="relative min-h-[70vh] overflow-hidden">
    <canvas id="dl-dither" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-bg" aria-hidden="true"></div>

    <div class="relative mx-auto flex max-w-6xl flex-col items-center px-4 py-20 sm:px-6">
      <p class="sec-mark">acquire the instrument</p>
      <h1 class="font-display mt-5 text-center text-5xl leading-[1.02] sm:text-6xl">
        get <span class="text-phosphor">whisperflow.</span>
      </h1>
      <p class="mt-4 text-center text-ink-dim">
        free, unlimited, open-source. windows today — macos &amp; linux on the roadmap.
      </p>

      <div class="panel mt-12 w-full max-w-md">
        <div class="panel-head">
          <span class="flex items-center gap-2.5">
            <span class="led led-breathe" data-on="live" aria-hidden="true"></span>
            <span class="mono-label text-ink-dim">windows · x64</span>
          </span>
          <span class="font-mono text-[11px] text-ink-faint">v0.1</span>
        </div>
        <div class="p-6">
          <a
            href="https://github.com/namandhakad712/whisperflow/releases/latest"
            class="btn btn-primary group relative w-full overflow-hidden"
          >
            <span class="relative z-10">⬇ download for windows</span>
            <span
              class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 group-hover:translate-x-full"
              aria-hidden="true"
            ></span>
          </a>
          <p class="mt-3 text-center font-mono text-[11px] text-ink-faint">
            installer arrives with the first tagged release — watch the repo.
          </p>

          <div class="my-6 flex items-center gap-3 font-mono text-[11px] text-ink-faint">
            <span class="h-px flex-1 bg-line"></span> or build from source <span class="h-px flex-1 bg-line"></span>
          </div>

          <div class="rounded-lg border border-line bg-bg px-4 py-3.5 font-mono text-[12.5px] leading-7 text-ink-dim">
            <p><span class="text-phosphor">$</span> git clone https://github.com/namandhakad712/whisperflow.git</p>
            <p><span class="text-phosphor">$</span> cd whisperflow && npm install</p>
            <p><span class="text-phosphor">$</span> npm run dev</p>
          </div>

          <ul class="mt-6 space-y-2.5 font-mono text-[13px] text-ink-dim">
            <li class="flex gap-2.5"><span class="text-phosphor">[ok]</span> no account, no telemetry, no word caps</li>
            <li class="flex gap-2.5"><span class="text-phosphor">[ok]</span> models download once, work offline forever</li>
            <li class="flex gap-2.5"><span class="text-phosphor">[ok]</span> apache-2.0 — audit every line</li>
          </ul>
        </div>
      </div>

      <!-- first launch: the calibration sequence -->
      <div class="mt-14 grid w-full max-w-4xl gap-5 md:grid-cols-3">
        <SignalPanel label="01 · mic check" led="live">
          <div class="p-5">
            <p class="text-sm leading-6 text-ink-dim">
              the wizard checks your microphone and shows your voice as a live signal trace —
              you'll see yourself on the instrument before you ever speak to it.
            </p>
          </div>
        </SignalPanel>
        <SignalPanel label="02 · model pick" led="busy">
          <div class="p-5">
            <p class="text-sm leading-6 text-ink-dim">
              language, engine and sensitivity, recommended for your hardware. downloads resume
              if interrupted.
            </p>
          </div>
        </SignalPanel>
        <SignalPanel label="03 · first word" led="live" breathe>
          <div class="p-5">
            <p class="text-sm leading-6 text-ink-dim">
              hold the hotkey, say a sentence, watch it land. about two minutes from install
              to first dictation.
            </p>
          </div>
        </SignalPanel>
      </div>
    </div>
  </section>
</Base>

<script>
  import { DitherField, DITHER_PALETTES } from "@whisperflow/signal-engine";
  const light = document.documentElement.dataset.mode === "light";
  const canvas = document.getElementById("dl-dither") as HTMLCanvasElement | null;
  if (canvas) {
    new DitherField(canvas, {
      palette: light ? DITHER_PALETTES.light : DITHER_PALETTES.dark,
      cell: 6,
    }).mount();
  }
</script>
