---
import Base from "../layouts/Base.astro";
---
<Base
  title="Download — WhisperFlow"
  description="Download WhisperFlow for Windows, or build from source. Free, open-source, Apache-2.0."
>
  <section class="relative min-h-[82vh] overflow-hidden bg-sage/60">
    <!-- original squiggle art -->
    <svg class="pointer-events-none absolute -left-24 top-10 h-[420px] w-[520px] text-ink/15" viewBox="0 0 520 420" fill="none" aria-hidden="true">
      <path class="squiggle" d="M-20 120 C 120 60, 200 220, 340 170 S 520 90, 560 190 M-20 260 C 100 230, 220 340, 360 300 S 520 260, 560 330" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <div class="relative mx-auto flex max-w-6xl flex-col items-center px-4 py-16 sm:px-6">
      <div class="card w-full max-w-md p-8 shadow-[0_18px_50px_rgba(26,26,26,0.08)]">
        <h1 class="font-display text-center text-5xl">Get WhisperFlow</h1>
        <p class="mt-3 text-center text-sm text-ink-soft">
          Free, unlimited, open-source. Windows today — macOS &amp; Linux on the roadmap.
        </p>

        <a href="https://github.com/namandhakad712/whisperflow/releases/latest" class="btn-ink mt-7 w-full group relative overflow-hidden">
          <span class="relative z-10">⬇ Download for Windows</span>
          <span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-[#2952E3]/40 to-transparent transition-transform duration-700 group-hover:translate-x-full" aria-hidden="true"></span>
        </a>
        <p class="mt-2 text-center text-[11px] text-ink-faint">
          Installer arrives with the first tagged release (v0.1) — watch the repo.
        </p>

        <div class="my-6 flex items-center gap-3 text-xs text-ink-faint">
          <span class="h-px flex-1 bg-line"></span> or build from source <span class="h-px flex-1 bg-line"></span>
        </div>

        <div class="rounded-xl border border-line bg-cream px-4 py-3 font-mono text-[13px] leading-6 text-ink-soft">
          <p>git clone https://github.com/namandhakad712/whisperflow.git</p>
          <p>cd whisperflow && npm install</p>
          <p>npm run dev</p>
        </div>

        <ul class="mt-6 space-y-2 text-sm text-ink-soft">
          <li class="flex gap-2"><span class="text-forest">✓</span>No account, no telemetry, no word caps</li>
          <li class="flex gap-2"><span class="text-forest">✓</span>Models download once, work offline forever</li>
          <li class="flex gap-2"><span class="text-forest">✓</span>Apache-2.0 — audit every line</li>
        </ul>
      </div>

      <div class="mt-10 text-center">
        <p class="text-xs font-bold uppercase tracking-widest text-ink-faint">First launch</p>
        <p class="mt-2 max-w-sm text-sm text-ink-soft">
          The onboarding wizard checks your mic, configures the speech engine
          (language, model, sensitivity), and downloads what it needs — about two minutes, start to first dictation.
        </p>
      </div>
    </div>
  </section>
</Base>
