---
import Base from "../layouts/Base.astro";
import SignalPanel from "../components/SignalPanel.astro";
import FeatureCard from "../components/FeatureCard.astro";

const groups = [
  {
    num: "01",
    heading: "dictation",
    items: [
      { icon: "mic", title: "push-to-talk", body: "Ctrl+Shift+Space by default, fully rebindable. optional toggle mode for hands-free continuous dictation." },
      { icon: "sliders", title: "live overlay", body: "the phosphor capsule appears near your cursor: signal trace, streaming transcript, polish status. esc cancels instantly — nothing is injected." },
      { icon: "wand", title: "smart polish", body: "the local llm removes filler, fixes punctuation and capitalization, and structures rambling speech into clean prose." },
      { icon: "cpu", title: "tone presets", body: "neutral, casual, or professional output — plus custom instructions for total control over how your voice gets written down." },
    ],
  },
  {
    num: "02",
    heading: "accuracy that learns you",
    items: [
      { icon: "book", title: "personal dictionary", body: "add names, product terms, acronyms. fuzzy matching corrects near-misses after transcription, and every entry feeds the polisher's context." },
      { icon: "slash", title: "voice commands", body: "“scratch that” undoes the last dictation out of the box. define any phrase to insert snippets or replace text." },
      { icon: "history", title: "dictation history", body: "everything you've dictated, stored in a local sqlite database. search by keyword, replay, delete anything, clear all." },
    ],
  },
  {
    num: "03",
    heading: "yours, technically",
    items: [
      { icon: "shield", title: "local-only lock", body: "a hard network block enforced at the provider layer. when it's on, whisperflow cannot call out — provably." },
      { icon: "cpu", title: "model manager", body: "curated huggingface catalog with hardware-tiered recommendations. download gguf models with progress and resume, switch per task, delete anytime." },
      { icon: "sliders", title: "open providers", body: "clean stt and polish provider interfaces. local whisper.cpp and llama.cpp ship by default; byo openai-compatible endpoints if you insist on cloud." },
    ],
  },
];

const spec = [
  ["hotkey", "ctrl+shift+space (rebindable)"],
  ["stt engine", "whisper.cpp · ggml models"],
  ["polish engine", "llama.cpp · qwen 2.5 3b default"],
  ["vad", "rms energy · silero onnx optional"],
  ["audio", "16 khz pcm · audioworklet capture"],
  ["injection", "clipboard + synthesized paste"],
  ["storage", "json config (zod) + sqlite history"],
  ["telemetry", "none. zero. not a line."],
  ["license", "apache-2.0"],
];
---
<Base
  title="Features — WhisperFlow"
  description="Push-to-talk dictation, AI polish, personal dictionary, voice commands, local history and a model manager — all running locally."
>
  <section class="relative border-b border-line-soft">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="sec-mark">spec sheet</p>
      <h1 class="font-display mt-5 text-5xl leading-[1.02] sm:text-6xl">
        the full <span class="text-phosphor">rack.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-ink-dim">
        the complete dictation loop — capture, transcribe, polish, inject — on your machine,
        with open models you choose.
      </p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="border-b border-line-soft">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <p class="sec-mark">section {g.num} — {g.heading}</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((f) => <FeatureCard icon={f.icon} title={f.title} body={f.body} />)}
        </div>
      </div>
    </section>
  ))}

  <!-- spec table -->
  <section class="border-b border-line-soft bg-paper/30">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <p class="sec-mark">appendix — technical readout</p>
      <div class="panel mt-8">
        <div class="panel-head">
          <span class="flex items-center gap-2.5">
            <span class="led led-breathe" data-on="live" aria-hidden="true"></span>
            <span class="mono-label text-ink-dim">whisperflow v0.1 · runtime</span>
          </span>
          <span class="font-mono text-[11px] text-ink-faint">all values local</span>
        </div>
        <dl class="divide-y divide-line-soft">
          {spec.map(([k, v]) => (
            <div class="grid grid-cols-[9rem_1fr] gap-4 px-5 py-3.5 sm:grid-cols-[13rem_1fr]">
              <dt class="font-mono text-[12px] uppercase tracking-[0.08em] text-ink-faint">{k}</dt>
              <dd class="font-mono text-[13px] text-ink-dim">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
      <a href="/whisperflow/download/" class="btn btn-primary">download whisperflow</a>
    </div>
  </section>
</Base>
