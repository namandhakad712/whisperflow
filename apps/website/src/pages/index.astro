---
import Base from "../layouts/Base.astro";
---

<Base
  title="WhisperFlow — speak. it writes."
  description="Open-source, local-first voice dictation. Hold a key, speak naturally, get polished text in any app — whisper.cpp + llama.cpp on your machine. Free forever, no cloud, no caps."
>
  <!-- ============ HERO — the printed bloom ============ -->
  <section class="relative min-h-[94vh] overflow-hidden">
    <!-- Engine D: the orchid bloom, printed in dots -->
    <canvas id="hero-scene" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

    <!-- the print's paper band: type always sits on clean paper -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[46%]" style="background:linear-gradient(to top, var(--color-paper) 34%, color-mix(in srgb, var(--color-paper) 72%, transparent) 62%, transparent)" aria-hidden="true"></div>

    <!-- headline set OVER the art, left-anchored (editorial) -->
    <div class="relative mx-auto flex min-h-[94vh] max-w-6xl flex-col justify-end px-5 pb-20 pt-32 sm:px-8">
      <p class="eyebrow">local-first · free forever · works in every app</p>

      <h1 class="font-serif mt-6 max-w-3xl text-[13.5vw] font-normal leading-[0.98] tracking-[-0.015em] text-ink sm:text-7xl md:text-8xl">
        speak. it writes<span class="text-accent">.</span>
      </h1>

      <p class="mt-7 max-w-md text-[17px] leading-7 text-ink-2">
        hold one key, talk like you think — WhisperFlow turns speech into clean,
        polished text in any app. your words, rendered on your machine.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/whisperflow/download/" class="btn-ink">download for windows</a>
        <a href="https://github.com/namandhakad712/whisperflow" class="btn-quiet">read the source ↗</a>
        <span class="micro-note hidden sm:inline">macos + linux on the <a class="underline decoration-dotted underline-offset-4" href="https://github.com/namandhakad712/whisperflow">roadmap</a></span>
      </div>
    </div>

    <!-- corner print marks -->
    <div class="pointer-events-none absolute bottom-6 right-6 hidden font-mono text-[10px] uppercase tracking-[0.16em] text-ink-faint md:block" aria-hidden="true">
      fig. 01 — the bloom · printed in dots · v0.1.41
    </div>
  </section>

  <!-- ============ 01 — THE PROOF: real product, real words ============ -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <div class="grid gap-14 lg:grid-cols-[1fr_1.15fr] lg:items-center">
        <div>
          <p class="eyebrow">01 — the proof</p>
          <h2 class="font-serif mt-5 text-4xl font-normal leading-[1.05] text-ink sm:text-5xl">
            you don't type.<br />you already said it.
          </h2>
          <p class="mt-6 max-w-md text-[16px] leading-7 text-ink-2">
            the pill is the whole product: hold your hotkey anywhere, speak, and watch
            your sentence land — fillers removed, punctuation placed, tone matched.
            this is the actual overlay, running on windows.
          </p>
          <ul class="mt-8 space-y-3 font-mono text-[12px] text-ink-2">
            <li class="flex gap-3"><span class="text-accent">·</span> runs offline — your audio never leaves the machine</li>
            <li class="flex gap-3"><span class="text-accent">·</span> whisper.cpp transcribes, a local llm polishes</li>
            <li class="flex gap-3"><span class="text-accent">·</span> no account, no card, no word caps</li>
          </ul>
        </div>

        <!-- the specimen: the overlay, framed like a print -->
        <figure class="specimen">
          <div class="specimen-frame">
            <div class="overlay-demo" id="overlay-demo">
              <div class="overlay-wave">
                <canvas id="proof-wave" width="512" height="56" aria-hidden="true"></canvas>
              </div>
              <div class="overlay-text">
                <span id="proof-raw" class="proof-raw">…</span>
                <span id="proof-out" class="proof-out"></span><span class="caret" aria-hidden="true"></span>
              </div>
            </div>
            <p class="specimen-caption">
              fig. 02 — the overlay capsule · hold-to-talk · simulated transcript, the desktop app is the real thing
            </p>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ 02 — RAMBLE → RENDERED (the live transform) ============ -->
  <section class="border-t border-rule bg-tint">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="eyebrow">02 — the whole trick</p>
      <h2 class="font-serif mt-5 max-w-2xl text-4xl font-normal leading-[1.05] text-ink sm:text-5xl">
        ramble in. <span class="text-accent">rendered out.</span>
      </h2>
      <p class="mt-6 max-w-md text-[16px] leading-7 text-ink-2">
        this is the moment users love: your speech, cleaned. press play — or use your
        microphone and watch <em class="not-italic font-medium">your own words</em> come back polished.
      </p>

      <div class="mt-12 max-w-3xl">
        <div class="proof-card">
          <div class="flex items-center justify-between gap-4 border-b border-rule px-6 py-3.5">
            <span class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-2">
              <span class="pulse-dot" id="transform-dot"></span>
              <span id="transform-state">ready</span>
            </span>
            <button type="button" id="transform-play" class="btn-quiet !py-1.5 !text-[12px]">▶ play the transform</button>
          </div>
          <div class="grid gap-8 p-6 sm:p-8 md:grid-cols-[1fr_auto_1fr] md:items-center">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-faint">what you said</p>
              <p class="mt-3 font-mono text-[13px] leading-6 text-ink-2" id="t-raw">
                so basically um i think we should uh ship the demo like tomorrow-ish because
                you know the launch is monday and the overlay basically works
              </p>
            </div>
            <div class="flex items-center justify-center" aria-hidden="true">
              <svg viewBox="0 0 48 16" class="h-4 w-12 text-accent" fill="none">
                <path d="M0 8 H14 M18 8 h1.5 m2 0 h1.5 m2 0 h1.5 M30 8 H48" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="2 3.5"/>
              </svg>
            </div>
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-accent">what appears</p>
              <p class="mt-3 text-[15px] leading-7 text-ink" id="t-out">We should ship the demo tomorrow — the launch is Monday, and the overlay works.</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-2 border-t border-rule px-6 py-3 font-mono text-[10px] uppercase tracking-[0.14em] text-ink-faint">
            <span id="t-mode">simulated example — the app does this with your real voice</span>
            <button type="button" id="t-mic" class="underline decoration-dotted underline-offset-4 hover:text-accent">use my microphone</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 — WHY LOCAL ============ -->
  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div class="order-2 lg:order-1">
          <p class="eyebrow">03 — why local</p>
          <h2 class="font-serif mt-5 text-4xl font-normal leading-[1.05] text-ink sm:text-5xl">
            cloud tools meter your words.<br />we can't.
          </h2>
          <p class="mt-6 max-w-md text-[16px] leading-7 text-ink-2">
            there is no counter to check and no server to phone. local-only mode is a
            hard network block at the provider layer — when it's on, WhisperFlow
            <em class="not-italic font-medium text-ink">cannot</em> call out. the whole
            schematic is public, apache-2.0.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="https://github.com/namandhakad712/whisperflow" class="btn-quiet">audit the code ↗</a>
            <a href="/whisperflow/docs/privacy/" class="btn-quiet">privacy docs</a>
          </div>
        </div>

        <figure class="order-1 lg:order-2">
          <div class="specimen-frame">
            <canvas id="dune-scene" class="block h-64 w-full sm:h-80" aria-hidden="true"></canvas>
            <p class="specimen-caption">fig. 03 — every stage local: capture · transcribe · polish · paste</p>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ 04 — THE FEATURES INDEX ============ -->
  <section class="border-t border-rule bg-tint">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">04 — contents</p>
          <h2 class="font-serif mt-5 text-4xl font-normal leading-[1.05] text-ink sm:text-5xl">the full instrument.</h2>
        </div>
        <a href="/whisperflow/features/" class="btn-quiet">full spec sheet →</a>
      </div>

      <div class="relative mt-12">
        <canvas id="contours-scene" class="absolute inset-0 h-full w-full opacity-60" aria-hidden="true"></canvas>
        <ol class="relative">
          {[
            ["01", "push-to-talk", "one global hotkey, rebindable — or toggle mode for hands-free"],
            ["02", "the live overlay", "the capsule: signal trace, streaming transcript, esc kills it"],
            ["03", "smart polish", "fillers out, punctuation in, tone presets — a local llm, your rules"],
            ["04", "dictionary + commands", "names and terms learned; “scratch that” undoes"],
            ["05", "history, local", "sqlite on your disk — searchable, deletable, yours"],
            ["06", "model manager", "curated gguf catalog, hardware-tiered, resumable downloads"],
            ["07", "the local-only lock", "a hard network block — provably off-grid"],
            ["08", "open providers", "whisper.cpp + llama.cpp by default; bring any endpoint"],
          ].map(([num, title, body]) => (
            <li class="group grid grid-cols-[3rem_1fr] items-baseline gap-4 border-b border-rule py-5 sm:grid-cols-[4rem_16rem_1fr]">
              <span class="font-mono text-[11px] text-ink-faint">{num}</span>
              <span class="font-mono text-[13px] font-medium text-ink group-hover:text-accent">{title}</span>
              <span class="col-span-2 mt-1.5 text-[14px] leading-6 text-ink-2 sm:col-span-1 sm:mt-0">{body}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 05 — HONEST FAQ ============ -->
  <section class="mx-auto max-w-3xl px-5 py-24 sm:px-8 sm:py-32">
    <p class="eyebrow">05 — good questions</p>
    <h2 class="font-serif mt-5 text-4xl font-normal leading-[1.05] text-ink sm:text-5xl">asked often.</h2>
    <div class="mt-12 space-y-3.5">
      {[
        ["is it really free?", "yes — the core app is free forever with no word caps and no account. sponsor tiers fund development; they don't unlock dictation, because dictation isn't locked."],
        ["does it need the internet?", "once, to download models from huggingface. after that it runs fully offline — planes, airports, dead zones."],
        ["how is this different from cloud dictation?", "cloud tools stream your voice to servers and meter your words. whisperflow transcribes and polishes locally — private, unlimited, free. the trade: you need a real computer, not a browser tab."],
        ["what hardware does it need?", "any modern pc. 8 gb ram runs the balanced setup; 16 gb unlocks the best models. onboarding checks your machine and recommends."],
        ["windows only?", "windows ships first; the engine is cross-platform and macos/linux packaging is on the roadmap."],
        ["what's the catch?", "models are big (the wizard downloads them once), and polish quality depends on your gpu. that's it. it's apache-2.0 — read every line."],
      ].map(([q, a]) => (
        <details class="faq group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 border-b border-rule pb-4 pt-1 font-mono text-[14px] text-ink">
            {q}
            <span class="faq-glyph text-ink-faint">+</span>
          </summary>
          <p class="max-w-xl pb-5 pt-3 text-[14.5px] leading-7 text-ink-2">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="relative overflow-hidden border-t border-rule">
    <canvas id="cta-scene" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="relative mx-auto max-w-6xl px-5 py-28 text-center sm:px-8 sm:py-36">
      <h2 class="font-serif mx-auto max-w-2xl text-5xl font-normal leading-[1.02] text-ink sm:text-7xl">
        hand it<br />the talking<span class="text-accent">.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-md text-[16px] leading-7 text-ink-2">
        download, pick a model, dictate your first sentence in five minutes.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/whisperflow/download/" class="btn-ink">download for windows</a>
        <a href="/whisperflow/features/" class="btn-quiet">explore features</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { PaintedScene, SCENE_BLOOM, SCENE_CONTOURS, SCENE_DUNE } from "@whisperflow/signal-engine";

  // v3: light (cream) is the default; "dark" dataset mode switches the print
  const dark = document.documentElement.dataset.mode === "dark";
  const paper = dark ? "ink" : "cream";

  const hero = new PaintedScene(document.getElementById("hero-scene") as HTMLCanvasElement, {
    scene: SCENE_BLOOM,
    cell: 5,
    paper,
    drift: 1,
    image: "/whisperflow/prints/orchid.jpg",
    imageCrop: [0.55, 0.42, 1.6], // one dominant bloom, cropped hard
  });
  hero.mount();

  const dune = document.getElementById("dune-scene") as HTMLCanvasElement | null;
  if (dune) new PaintedScene(dune, { scene: SCENE_DUNE, cell: 8, paper, drift: 0.7 }).mount();

  const contours = document.getElementById("contours-scene") as HTMLCanvasElement | null;
  if (contours) new PaintedScene(contours, { scene: SCENE_CONTOURS, cell: 9, paper, drift: 0.5 }).mount();

  const cta = document.getElementById("cta-scene") as HTMLCanvasElement | null;
  if (cta) new PaintedScene(cta, { scene: SCENE_BLOOM, cell: 10, paper, drift: 0.6 }).mount();

  // ---- the overlay specimen: the capsule, live ----
  const RAW = [
    "so basically um ship the demo",
    "uh i think the launch is monday",
    "you know the overlay basically works",
    "like tell the team we're live tomorrow",
  ];
  const OUT = [
    "We should ship the demo.",
    "The launch is Monday.",
    "The overlay works.",
    "Tell the team we're live tomorrow.",
  ];
  let di = 0;
  const el = (id: string) => document.getElementById(id)!;
  const wave = document.getElementById("proof-wave") as HTMLCanvasElement;
  const wctx = wave.getContext("2d")!;
  let speaking = false;
  let phase = 0;

  const drawWave = () => {
    const w = wave.width, h = wave.height;
    wctx.clearRect(0, 0, w, h);
    wctx.strokeStyle = "#0E7A55";
    wctx.lineWidth = 2;
    wctx.beginPath();
    for (let x = 0; x <= w; x += 3) {
      const amp = speaking
        ? 4 + 14 * Math.abs(Math.sin(x * 0.05 + phase) * Math.sin(x * 0.013 + phase * 0.7))
        : 1.2 + Math.sin(x * 0.03 + phase * 0.4) * 1.2;
      const y = h / 2 + Math.sin(x * 0.05 + phase) * amp;
      if (x === 0) wctx.moveTo(x, y); else wctx.lineTo(x, y);
    }
    wctx.stroke();
    phase += speaking ? 0.35 : 0.02;
    requestAnimationFrame(drawWave);
  };
  drawWave();

  const overlayDemo = () => {
    setTimeout(() => {
      speaking = true;
      el("proof-raw").textContent = RAW[di];
      el("proof-out").textContent = "";
      setTimeout(() => {
        speaking = false;
        const target = OUT[di];
        let f = 0;
        const sweep = window.setInterval(() => {
          f++;
          const settled = Math.floor((f / 14) * target.length);
          el("proof-out").textContent = target.slice(0, settled);
          if (settled >= target.length) {
            window.clearInterval(sweep);
            di = (di + 1) % RAW.length;
            window.setTimeout(overlayDemo, 2600);
          }
        }, 34);
      }, 1700);
    }, 900);
  };
  overlayDemo();

  // ---- the transform section: simulated → real (mic optional) ----
  const SIM_RAW = "so basically um i think we should uh ship the demo like tomorrow-ish because you know the launch is monday and the overlay basically works";
  const SIM_OUT = "We should ship the demo tomorrow — the launch is Monday, and the overlay works.";
  el("transform-play").addEventListener("click", () => {
    const rawEl = el("t-raw"), outEl = el("t-out");
    el("transform-state").textContent = "listening…";
    el("transform-dot").classList.add("busy");
    rawEl.textContent = "";
    outEl.textContent = "";
    let i = 0;
    const typer = window.setInterval(() => {
      i += Math.floor(Math.random() * 4) + 2;
      rawEl.textContent = SIM_RAW.slice(0, i);
      if (i >= SIM_RAW.length) {
        window.clearInterval(typer);
        el("transform-state").textContent = "polishing…";
        window.setTimeout(() => {
          let j = 0;
          const out = window.setInterval(() => {
            j += 2;
            outEl.textContent = SIM_OUT.slice(0, j);
            if (j >= SIM_OUT.length) {
              window.clearInterval(out);
              el("transform-state").textContent = "rendered ✓";
              el("transform-dot").classList.remove("busy");
              el("transform-dot").classList.add("ok");
            }
          }, 18);
        }, 700);
      }
    }, 30);
  });

  interface RecEvent { results: ArrayLike<ArrayLike<{ transcript: string }> & { isFinal: boolean }> }
  const SR = window as unknown as { SpeechRecognition?: new () => SpeechRec; webkitSpeechRecognition?: new () => SpeechRec };
  interface SpeechRec {
    continuous: boolean; interimResults: boolean; lang: string;
    start(): void;
    onresult: ((e: RecEvent) => void) | null;
    onerror: (() => void) | null;
    onend: (() => void) | null;
  }
  el("t-mic").addEventListener("click", () => {
    const Rec = SR.SpeechRecognition ?? SR.webkitSpeechRecognition;
    if (!Rec) {
      el("t-mode").textContent = "this browser has no speech api — the desktop app is the real thing";
      return;
    }
    const rec = new Rec();
    rec.continuous = false;
    rec.interimResults = true;
    rec.lang = "en-US";
    let final = "";
    el("t-mode").textContent = "listening — speak now, then stay quiet a moment";
    el("transform-state").textContent = "listening…";
    el("transform-dot").classList.add("busy");
    el("t-raw").textContent = "…";
    el("t-out").textContent = "";
    el("transform-dot").classList.remove("ok");
    rec.onresult = (e) => {
      let interim = "";
      for (let k = 0; k < e.results.length; k++) {
        const r = e.results[k] as ArrayLike<{ transcript: string }> & { isFinal: boolean };
        if (r.isFinal) final += (r[0] as { transcript: string }).transcript + " ";
        else interim += (r[0] as { transcript: string }).transcript;
      }
      el("t-raw").textContent = (final + interim).trim() || "…";
    };
    rec.onerror = () => {
      el("t-mode").textContent = "mic unavailable — showing the simulated example";
      el("transform-state").textContent = "ready";
      el("transform-dot").classList.remove("busy");
    };
    rec.onend = () => {
      el("transform-dot").classList.remove("busy");
      const spoken = (final || el("t-raw").textContent || "").trim();
      if (spoken && spoken !== "…") {
        const cleaned = spoken
          .replace(/\b(um+|uh+|erm|like,|you know,|basically|actually)\s*/gi, "")
          .replace(/\s+/g, " ")
          .trim();
        const out = cleaned.charAt(0).toUpperCase() + cleaned.slice(1).replace(/([.!?])?\s*$/, ".");
        let j = 0;
        el("transform-state").textContent = "polishing…";
        const t = window.setInterval(() => {
          j += 2;
          el("t-out").textContent = out.slice(0, j);
          if (j >= out.length) {
            window.clearInterval(t);
            el("transform-state").textContent = "rendered ✓ — yours, from your mic";
            el("t-mode").textContent = "real speech api output — the desktop app does this with whisper.cpp + a local llm";
            el("transform-dot").classList.add("ok");
          }
        }, 16);
      }
    };
    rec.start();
  });
</script>
