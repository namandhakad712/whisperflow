---
import Base from "../layouts/Base.astro";
import SignalPanel from "../components/SignalPanel.astro";
---

<Base
  title="WhisperFlow — your voice, rendered."
  description="Open-source, local-first AI voice dictation. Hold a key, speak naturally, get polished text in any app — powered by whisper.cpp and llama.cpp on your machine. Free forever, unlimited, no cloud."
>
  <!-- ================= HERO — the signal field ================= -->
  <section class="relative min-h-[92vh] overflow-hidden">
    <!-- Engine A: breathing dither field -->
    <canvas id="hero-dither" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-bg" aria-hidden="true"></div>

    <div class="relative mx-auto flex min-h-[92vh] max-w-6xl flex-col items-center px-4 pb-16 pt-20 sm:px-6">
      <p class="sec-mark">open-source · local-first · no caps</p>

      <h1 class="font-display mx-auto mt-7 max-w-4xl text-center text-[13vw] font-medium leading-[0.98] tracking-[-0.02em] sm:text-7xl md:text-8xl">
        your voice,<br />
        <span class="text-phosphor" data-scramble="rendered.">rendered.</span>
      </h1>

      <p class="mx-auto mt-7 max-w-xl text-center text-base leading-7 text-ink-dim sm:text-lg sm:leading-8">
        WhisperFlow turns speech into clean, polished text in any app — transcribed and
        refined entirely on your machine by open models. free. unlimited. un-cloudable.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/whisperflow/download/" class="btn btn-primary">get started on windows</a>
        <a href="https://github.com/namandhakad712/whisperflow" class="btn btn-ghost">read the schematics ↗</a>
      </div>
      <p class="mt-4 font-mono text-[11px] tracking-[0.12em] text-ink-faint">
        FREE FOREVER · NO ACCOUNT · NO WORD CAPS
      </p>

      <!-- ============ THE SHOW: hold-to-speak demo + ASCII signal ============ -->
      <div class="relative mt-16 w-full max-w-3xl">
        <!-- Engine B: the signal made of text -->
        <div class="relative h-56 overflow-hidden rounded-xl border border-line-soft sm:h-64" id="ascii-stage">
          <canvas id="hero-ascii" class="ascii-canvas absolute inset-0" aria-hidden="true"></canvas>
        </div>

        <!-- the instrument: hold SPACE (or press the keycap) to transmit -->
        <div class="panel mx-auto -mt-10 w-[min(94%,42rem)]">
          <div class="panel-head">
            <span class="flex items-center gap-2.5">
              <span class="led" id="demo-led" aria-hidden="true"></span>
              <span class="mono-label text-ink-dim" id="demo-state">standby</span>
            </span>
            <span class="font-mono text-[11px] text-ink-faint">
              <span id="demo-clock">00:00</span> · <span id="demo-db">−∞ dB</span>
            </span>
          </div>
          <div class="flex flex-col gap-5 p-5 sm:flex-row sm:items-center">
            <button
              type="button"
              id="hold-key"
              class="group relative flex h-24 w-24 shrink-0 select-none items-center justify-center rounded-lg sm:h-20 sm:w-32"
              aria-label="Press and hold to try dictation"
            >
              <span class="absolute inset-0 rounded-lg bg-[#040507] shadow-[inset_0_2px_5px_rgba(0,0,0,0.95),0_10px_24px_rgba(0,0,0,0.7)]"></span>
              <span class="keycap-cap absolute inset-[3px] rounded-md bg-gradient-to-b from-[#1B1E24] via-[#121419] to-[#0B0D11] shadow-[inset_0_1px_0_rgba(255,255,255,0.22),inset_0_-3px_6px_rgba(0,0,0,0.85)] transition-transform duration-100 group-active:translate-y-[3px]"></span>
              <span class="keycap-dish absolute inset-[7px] flex items-center justify-center rounded-sm bg-gradient-to-b from-[#16181E] to-[#12141A] font-mono text-[11px] font-medium tracking-[0.14em] text-ink shadow-[inset_0_1px_1px_rgba(255,255,255,0.16),inset_0_-1px_2px_rgba(0,0,0,0.6)]">
                hold
              </span>
            </button>
            <div class="min-w-0 flex-1">
              <p class="font-mono text-[13px] leading-6">
                <span class="text-ink-faint" id="demo-raw">…press and hold. say something.</span>
              </p>
              <p class="mt-2 text-sm leading-6 text-ink-dim">
                <span class="text-phosphor" id="demo-out"></span><span class="demo-caret" aria-hidden="true"></span>
              </p>
            </div>
          </div>
          <div class="flex items-center justify-between border-t border-line-soft px-5 py-2.5 font-mono text-[11px] text-ink-faint">
            <span>whisper.cpp · qwen 2.5 · <span class="text-phosphor">local</span></span>
            <span id="demo-latency">— ms</span>
          </div>
        </div>
        <p class="mt-4 text-center font-mono text-[11px] tracking-[0.08em] text-ink-faint">
          hold <span class="kbd-chip">space</span> anywhere on this page — the demo transmits silence as if it were speech
        </p>
      </div>
    </div>
  </section>

  <!-- ================= 01 — HOW IT WORKS: three instrument panels ================= -->
  <section class="relative border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="sec-mark">section 01 — the loop</p>
      <h2 class="font-display mt-5 max-w-2xl text-4xl leading-[1.05] sm:text-6xl">
        everything runs <span class="text-phosphor">here.</span>
      </h2>
      <p class="mt-5 max-w-md text-ink-dim">
        not on a server somewhere. on the machine you already own — three stages, one signal path.
      </p>

      <div class="mt-14 grid gap-5 md:grid-cols-3">
        <SignalPanel label="ear · whisper.cpp" led="live" breathe meta="stt">
          <div class="p-6">
            <p class="font-mono text-[13px] text-phosphor">streaming transcription</p>
            <p class="mt-3 text-sm leading-6 text-ink-dim">
              silence endpointing, 100+ languages, partial results as you speak — zero audio
              leaves the device. the mic is an instrument, not a microphone array in virginia.
            </p>
            <p class="mt-4 font-mono text-2xl text-ink">0<span class="text-sm text-ink-faint"> bytes uploaded</span></p>
          </div>
        </SignalPanel>
        <SignalPanel label="mind · llama.cpp" led="busy" meta="polish">
          <div class="p-6">
            <p class="font-mono text-[13px] text-violet">local llm refinement</p>
            <p class="mt-3 text-sm leading-6 text-ink-dim">
              a small local model removes filler, fixes punctuation, follows your tone presets —
              or bring any OpenAI-compatible endpoint, with your key, stored only on your machine.
            </p>
            <p class="mt-4 font-mono text-2xl text-ink">~3<span class="text-sm text-ink-faint"> s hotkey → text</span></p>
          </div>
        </SignalPanel>
        <SignalPanel label="memory · sqlite" led="live" breathe meta="yours">
          <div class="p-6">
            <p class="font-mono text-[13px] text-phosphor">dictionary · history · commands</p>
            <p class="mt-3 text-sm leading-6 text-ink-dim">
              your names, terms and past dictations live in local storage. one switch makes the
              app physically unable to phone home. delete anything, any time.
            </p>
            <p class="mt-4 font-mono text-2xl text-ink">∞<span class="text-sm text-ink-faint"> words per week</span></p>
          </div>
        </SignalPanel>
      </div>
    </div>
  </section>

  <!-- ================= 02 — SIGNAL vs NOISE (the product demo in type) ================= -->
  <section class="relative border-t border-line-soft bg-paper/30">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="sec-mark">section 02 — signal vs noise</p>
      <h2 class="font-display mt-5 max-w-2xl text-4xl leading-[1.05] sm:text-6xl">
        noise in. <span class="text-phosphor">signal out.</span>
      </h2>
      <p class="mt-5 max-w-md text-ink-dim">
        the polish pass is the whole trick — and you control it. flip the tone and watch the same
        sentence come out different.
      </p>

      <div class="panel mt-14 p-6 sm:p-10">
        <div class="grid items-stretch gap-6 md:grid-cols-[1fr_auto_1fr]">
          <div>
            <p class="mono-label text-ink-faint">/// raw transcript</p>
            <p class="mt-4 font-mono text-sm leading-7 text-ink-dim">
              so basically um i think we should <span class="text-coral">uh</span> ship the demo
              like tomorrow-ish because <span class="text-coral">you know</span> the launch is
              monday and the overlay basically works
            </p>
          </div>
          <div class="flex items-center justify-center" aria-hidden="true">
            <div class="flex flex-col items-center gap-2">
              <span class="led" data-on="busy"></span>
              <svg viewBox="0 0 64 16" class="h-4 w-16 text-phosphor" fill="none">
                <path d="M0 8 H20 M24 8 h2 m2 0 h2 m2 0 h2 M36 8 H64" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="3 4" />
              </svg>
              <span class="mono-label text-violet">polish</span>
            </div>
          </div>
          <div>
            <p class="mono-label text-phosphor">/// rendered · <span id="tone-label">neutral</span></p>
            <p class="mt-4 text-sm leading-7 text-ink" id="tone-out">
              We should ship the demo tomorrow — the launch is Monday, and the overlay works.
            </p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-2 border-t border-line-soft pt-6">
          {["neutral", "casual", "professional"].map((tone) => (
            <button
              type="button"
              data-tone={tone}
              class="tone-btn rounded-md border border-line px-3.5 py-1.5 font-mono text-[12px] text-ink-dim transition-colors hover:border-phosphor hover:text-phosphor"
            >
              {tone}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 03 — THE PRIVACY METER ================= -->
  <section class="relative border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="sec-mark">section 03 — the only meter is yours</p>
          <h2 class="font-display mt-5 text-4xl leading-[1.05] sm:text-5xl">
            cloud tools meter your words.<br />we can't.
          </h2>
          <p class="mt-5 max-w-md text-ink-dim">
            there is no counter to check and no server to phone. the local-only mode is a hard
            network block at the provider layer — when it's on, WhisperFlow <em>cannot</em> call
            out. verify it yourself: the whole schematic is public.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="https://github.com/namandhakad712/whisperflow" class="btn btn-ghost">audit the code ↗</a>
            <a href="/whisperflow/docs/privacy/" class="btn btn-ghost">privacy docs</a>
          </div>
        </div>
        <SignalPanel label="transmission log" led="live" breathe meta="live">
          <div class="p-5">
            <pre class="select-none font-mono text-[12px] leading-7" aria-hidden="true"><span class="text-phosphor">[ok]</span> mic captured .......... <span class="text-ink">local</span>
<span class="text-phosphor">[ok]</span> whisper.cpp transcribe ... <span class="text-ink">local</span>
<span class="text-phosphor">[ok]</span> qwen polish ............. <span class="text-ink">local</span>
<span class="text-phosphor">[ok]</span> paste at cursor ......... <span class="text-ink">local</span>
<span class="text-ink-faint">──────────────────────────────────</span>
<span class="text-phosphor">[ok]</span> bytes sent to any cloud . <span class="text-ink">0</span> ∞</pre>
            <p class="sr-only">Transmission log: every stage — capture, transcription, polish, paste — runs locally. Bytes sent to any cloud: zero, always.</p>
          </div>
        </SignalPanel>
      </div>
    </div>
  </section>

  <!-- ================= 04 — FEATURES STRIP (marquee) ================= -->
  <section class="relative overflow-hidden border-t border-line-soft bg-paper/30 py-24 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="sec-mark">section 04 — the full rack</p>
      <h2 class="font-display mt-5 text-4xl leading-[1.05] sm:text-5xl">
        one instrument, <span class="text-phosphor">every register.</span>
      </h2>
    </div>
    <div class="group relative mt-14">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-bg to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-bg to-transparent" aria-hidden="true"></div>
      <div class="marquee-track px-6 py-2">
        {[
          ["/// 01", "push-to-talk", "global hotkey, rebindable. toggle mode for hands-free."],
          ["/// 02", "live overlay", "phosphor capsule: trace, transcript, polish status. esc kills it."],
          ["/// 03", "smart polish", "filler removal, punctuation, structure — tone presets included."],
          ["/// 04", "dictionary", "names and terms, fuzzy-corrected after transcription."],
          ["/// 05", "voice commands", "“scratch that” undoes. your phrases trigger anything."],
          ["/// 06", "history", "local sqlite. searchable. deletable. yours."],
          ["/// 07", "model manager", "curated catalog, hardware-tiered picks, resumable downloads."],
          ["/// 08", "local-only lock", "a hard network block. provably off-grid."],
        ].map(([num, title, body], i) => (
          <>
            <div class="panel w-72 shrink-0">
              <div class="panel-head">
                <span class="mono-label text-ink-faint">{num}</span>
                <span class="led" data-on={i < 3 ? "live" : "off"} class:list={i === 0 ? ["led-breathe"] : []} aria-hidden="true"></span>
              </div>
              <div class="p-5">
                <p class="font-mono text-sm font-medium text-ink">{title}</p>
                <p class="mt-2 text-[13px] leading-5 text-ink-dim">{body}</p>
              </div>
            </div>
            <div class="panel w-72 shrink-0" aria-hidden="true">
              <div class="panel-head">
                <span class="mono-label text-ink-faint">{num}</span>
                <span class="led" data-on={i < 3 ? "live" : "off"}></span>
              </div>
              <div class="p-5">
                <p class="font-mono text-sm font-medium text-ink">{title}</p>
                <p class="mt-2 text-[13px] leading-5 text-ink-dim">{body}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
    <div class="mx-auto mt-12 max-w-6xl px-4 text-center sm:px-6">
      <a href="/whisperflow/features/" class="btn btn-ghost">full spec sheet →</a>
    </div>
  </section>

  <!-- ================= 05 — FAQ ================= -->
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6 sm:py-32">
    <p class="sec-mark">section 05 — good questions</p>
    <h2 class="font-display mt-5 text-4xl leading-[1.05] sm:text-5xl">asked <span class="text-phosphor">often.</span></h2>
    <div class="mt-12 space-y-3">
      {[
        ["is it really free?", "yes — the core app is free forever, with no word caps or accounts. sponsor tiers fund development; they don't unlock dictation, because dictation isn't locked."],
        ["does it need the internet?", "only once, to download models from huggingface. after that it works fully offline — planes, airports, hotel wi-fi."],
        ["how is this different from cloud dictation?", "cloud tools stream your voice to servers and meter your words. whisperflow transcribes locally with whisper.cpp and polishes locally with a small llm — private, unlimited, free."],
        ["what hardware does it need?", "any modern pc. 8 gb ram runs the balanced setup; 16 gb unlocks the best models. onboarding checks and recommends for you."],
        ["windows only?", "windows ships first; the engine is cross-platform and macos/linux packaging is on the roadmap."],
      ].map(([q, a]) => (
        <details class="faq panel group">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 text-[15px] font-medium text-ink">
            {q}
            <span class="faq-glyph font-mono text-lg leading-none text-ink-faint">+</span>
          </summary>
          <p class="border-t border-line-soft px-6 py-5 text-sm leading-6 text-ink-dim">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ================= 06 — CTA: hand it the talking ================= -->
  <section class="relative overflow-hidden border-t border-line-soft">
    <!-- Engine A again: an aurora rising -->
    <canvas id="cta-dither" class="absolute inset-0 h-full w-full opacity-70" aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-bg via-transparent to-bg" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-32 text-center sm:px-6 sm:py-40">
      <p class="sec-mark">section 06 — transmit</p>
      <h2 class="font-display mx-auto mt-6 max-w-3xl text-5xl leading-[1.02] sm:text-7xl">
        hand whisperflow<br /><span class="text-phosphor">the talking.</span>
      </h2>
      <p class="mx-auto mt-6 max-w-md text-ink-dim">
        download, pick a model, dictate your first sentence in under five minutes.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/whisperflow/download/" class="btn btn-primary">get started on windows</a>
        <a href="/whisperflow/features/" class="btn btn-ghost">explore features</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { DitherField, DITHER_PALETTES, AsciiRender, bindScrambles, holdDemo } from "@whisperflow/signal-engine";

  const light = document.documentElement.dataset.mode === "light";
  const palette = light ? DITHER_PALETTES.light : DITHER_PALETTES.dark;

  // Engine A — hero + CTA dither fields (scroll velocity drives the hero field)
  let scrollV = 0;
  let lastY = window.scrollY;
  window.addEventListener(
    "scroll",
    () => {
      scrollV = Math.min(1, Math.abs(window.scrollY - lastY) / 60);
      lastY = window.scrollY;
    },
    { passive: true },
  );

  const heroDither = new DitherField(document.getElementById("hero-dither") as HTMLCanvasElement, {
    palette,
    cell: 5,
    drive: () => scrollV * 0.6,
  });
  heroDither.mount();
  const ctaCanvas = document.getElementById("cta-dither") as HTMLCanvasElement | null;
  const ctaDither = ctaCanvas ? new DitherField(ctaCanvas, { palette, cell: 6 }) : null;
  ctaDither?.mount();

  // Engine B — the ASCII signal; the hold demo drives its amplitude
  let demoLevel = 0;
  const ascii = new AsciiRender(document.getElementById("hero-ascii") as HTMLCanvasElement, {
    columns: 110,
    drive: () => demoLevel,
    density: () => demoLevel,
  });
  ascii.mount();

  // scramble links
  const unscramble = bindScrambles();

  // ---- the hold-to-speak demo ----
  const RAW = [
    "so basically um ship the demo",
    "uh i think the launch is monday",
    "you know the overlay basically works",
    "like tell the team we're live tomorrow",
  ];
  const OUT = [
    "We should ship the demo.",
    "The launch is Monday.",
    "The overlay works.",
    "Tell the team we're live tomorrow.",
  ];
  let demoIdx = 0;
  const el = (id: string) => document.getElementById(id)!;
  const led = el("demo-led") as HTMLElement;
  const state = el("demo-state");
  const clock = el("demo-clock");
  const db = el("demo-db");
  const raw = el("demo-raw");
  const out = el("demo-out");
  const latency = el("demo-latency");
  const keycap = el("hold-key") as HTMLElement;
  let clockTimer = 0;

  const unbind = holdDemo(keycap, {
    onDrive: (level) => {
      demoLevel = level;
      if (level > 0) {
        led.dataset.on = "live";
        led.classList.add("led-breathe");
        state.textContent = "listening";
        const dbv = Math.round(-46 + level * 40);
        db.textContent = `${dbv} dB`;
      }
    },
    onRelease: (elapsed) => {
      led.dataset.on = "busy";
      led.classList.remove("led-breathe");
      state.textContent = "polishing";
      demoLevel = 0;
      db.textContent = "−∞ dB";
      window.clearInterval(clockTimer);
      clock.textContent = "00:00";
      const i = demoIdx % RAW.length;
      raw.textContent = RAW[i];
      out.textContent = "";
      // the dither-sweep polish: characters cycle the ramp, then settle
      const target = OUT[i];
      let frame = 0;
      const CH = "·:;=+x%#@";
      const sweep = window.setInterval(() => {
        frame++;
        const settled = Math.floor((frame / 26) * target.length);
        out.textContent =
          target.slice(0, settled) +
          Array.from({ length: target.length - settled }, () => CH[Math.floor(Math.random() * CH.length)]).join("");
        if (settled >= target.length) {
          window.clearInterval(sweep);
          led.dataset.on = "live";
          state.textContent = "[ok] pasted";
          latency.textContent = `${Math.round(240 + Math.random() * 180 + elapsed * 90)} ms`;
          demoIdx++;
        }
      }, 42);
    },
  });
  keycap.addEventListener("pointerdown", () => {
    const t0 = Date.now();
    clockTimer = window.setInterval(() => {
      const s = Math.floor((Date.now() - t0) / 1000);
      clock.textContent = `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
    }, 250);
  });

  // ---- tone toggle ----
  const TONES: Record<string, string> = {
    neutral: "We should ship the demo tomorrow — the launch is Monday, and the overlay works.",
    casual: "Let's ship the demo tomorrow. Launch is Monday and the overlay basically works!",
    professional:
      "I recommend we ship the demo tomorrow. The launch is scheduled for Monday, and the overlay is functioning as expected.",
  };
  document.querySelectorAll<HTMLButtonElement>(".tone-btn").forEach((btn) => {
    if (btn.dataset.tone === "neutral") {
      btn.classList.add("!border-phosphor", "!text-phosphor");
    }
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tone-btn").forEach((b) => b.classList.remove("!border-phosphor", "!text-phosphor"));
      btn.classList.add("!border-phosphor", "!text-phosphor");
      (document.getElementById("tone-label") as HTMLElement).textContent = btn.dataset.tone ?? "";
      (document.getElementById("tone-out") as HTMLElement).textContent = TONES[btn.dataset.tone ?? "neutral"] ?? "";
    });
  });

  // cleanup is unnecessary for a static page; engines stop with the tab
  void unbind;
  void unscramble;
</script>

<style>
  .demo-caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    margin-left: 3px;
    transform: translateY(2px);
    background: var(--color-phosphor);
    animation: caret-blink 1.1s steps(1) infinite;
  }
  @keyframes caret-blink {
    50% { opacity: 0; }
  }
  #hold-key:focus-visible {
    outline: 2px solid var(--color-phosphor);
    outline-offset: 3px;
    border-radius: 10px;
  }
</style>
