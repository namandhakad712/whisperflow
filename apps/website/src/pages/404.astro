---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — WhisperFlow">
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <pre class="select-none font-mono text-[13px] leading-[1.4] text-phosphor sm:text-[15px]" aria-hidden="true">┌───────────────────────────────┐
│     ·:·  E R R  4 0 4  ·:·    │
│        signal not found       │
│  ───────────────────────────  │
│   ._ intake ......... [ok]    │
│   ._ route .......... [--]    │
│   ._ recovery ....... [you]   │
└───────────────────────────────┘</pre>
    <h1 class="font-display mt-8 text-4xl font-bold tracking-[-0.04em] sm:text-5xl">this page kept its silence</h1>
    <p class="mt-4 font-mono text-sm text-ink-dim">the url you're after doesn't exist — or was misheard.</p>
    <div class="mt-9">
      <a href="/whisperflow/" class="btn btn-primary">back to the instrument</a>
    </div>
  </section>
</Base>
