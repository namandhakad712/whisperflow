---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---
<Base title="Page not found — WhisperFlow">
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">This page kept its silence</h1>
    <p class="mt-3 text-ink-dim">The URL you're after doesn't exist (or was misheard).</p>
    <div class="mt-8">
      <Button href="/whisperflow/">Back home</Button>
    </div>
  </section>
</Base>
