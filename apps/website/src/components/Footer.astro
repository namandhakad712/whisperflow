---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();

// the real shipped version — the desktop app's package.json is the source of truth
const desktopPkg = JSON.parse(
  readFileSync(resolve(process.cwd(), "../desktop/package.json"), "utf-8"),
) as { version: string };

const product = [
  ["features", "/whisperflow/features/"],
  ["download", "/whisperflow/download/"],
  ["docs", "/whisperflow/docs/"],
  ["pricing", "/whisperflow/pricing/"],
  ["changelog", "/whisperflow/changelog/"],
  ["sponsors", "/whisperflow/sponsors/"],
];
const resources = [
  ["getting started", "/whisperflow/docs/getting-started/"],
  ["hotkeys & overlay", "/whisperflow/docs/hotkeys/"],
  ["models & hardware", "/whisperflow/docs/models/"],
  ["privacy & data", "/whisperflow/docs/privacy/"],
];
const project = [
  ["github", "https://github.com/namandhakad712/whisperflow"],
  ["releases", "https://github.com/namandhakad712/whisperflow/releases"],
  ["issues", "https://github.com/namandhakad712/whisperflow/issues"],
  ["security", "https://github.com/namandhakad712/whisperflow/blob/main/SECURITY.md"],
];
---
<footer class="relative border-t border-line bg-paper/40">
  <!-- status strip — the instrument's back panel -->
  <div class="border-b border-line-soft">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-7 gap-y-2 px-4 py-4 font-mono text-[11px] tracking-[0.06em] text-ink-dim sm:px-6">
      <span class="flex items-center gap-2">
        <span class="led led-breathe" data-on="live" aria-hidden="true"></span>
        all systems local — nothing to be down
      </span>
      <span>v{desktopPkg.version}</span>
      <span>apache-2.0</span>
      <span class="ml-auto tracking-[0.1em]">0 telemetry · 0 accounts · 0 caps</span>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.5fr_repeat(3,1fr)]">
      <div>
        <a href="/whisperflow/" aria-label="WhisperFlow home"><Logo class="h-6" /></a>
        <p class="mt-5 max-w-xs text-sm leading-6 text-ink-dim">
          Open-source, local-first voice dictation. Your voice, your models, your machine.
        </p>
        <!-- the wiring diagram: the app's actual signal path, annotated -->
        <pre class="mt-6 select-none font-mono text-[10px] leading-[1.45] text-phosphor/80" aria-hidden="true">mic ──▶ vad ──▶ whisper.cpp ──▶ llama.cpp ──▶ paste
      │       │        │  stt         │  polish    │
     ▼       ▼        ▼              ▼            ▼
   local   local    local          local        local
                      └──── 0 bytes leave the machine ────┘</pre>
      </div>
      {([["product", product], ["resources", resources], ["project", project]] as Array<[string, string[][]]>).map(([title, links]) => (
        <div>
          <p class="mono-label text-ink-faint">{title}</p>
          <ul class="mt-4 space-y-2.5 font-mono text-[13px]">
            {links.map(([label, href]) => (
              <li>
                <a class="text-ink-dim transition-colors hover:text-phosphor" href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- wordmark finale — mono, the terminal voice signs off -->
    <div class="mt-16 flex items-end justify-center gap-4 select-none" aria-hidden="true">
      <svg viewBox="0 0 28 24" class="mb-4 h-12 w-auto text-phosphor sm:h-16" fill="none">
        <path
          d="M2 6 L7 18 L11 9 L14 20 L17 9 L21 18 L26 6"
          stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        <path
          d="M2 6 L7 18 L11 9 L14 20 L17 9 L21 18 L26 6"
          stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.14" />
      </svg>
      <p class="font-mono text-[10.5vw] font-bold leading-[0.85] tracking-[-0.05em] text-ink/90 sm:text-[6rem]">
        WhisperFlow
      </p>
    </div>
  </div>

  <div class="mt-10 border-t border-line-soft">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 font-mono text-[11px] text-ink-faint sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} WhisperFlow contributors · Apache-2.0</p>
      <p>not affiliated with Wispr Inc. · built with whisper.cpp &amp; llama.cpp</p>
    </div>
  </div>
</footer>
