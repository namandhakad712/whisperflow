---
import Logo from "./Logo.astro";

const nav = [
  { href: "/whisperflow/features/", label: "features" },
  { href: "/whisperflow/docs/", label: "docs" },
  { href: "/whisperflow/pricing/", label: "pricing" },
  { href: "/whisperflow/changelog/", label: "changelog" },
];
const path = Astro.url.pathname;
---
<div class="border-b border-line-soft bg-paper text-center">
  <p class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-2 font-mono text-[11px] tracking-[0.08em] text-ink-dim">
    <span class="inline-flex items-center gap-1.5">
      <span class="led led-breathe" data-on="live" aria-hidden="true"></span>
      local-first
    </span>
    <span class="text-ink-faint">·</span>
    <span>no accounts · no word caps · no telemetry</span>
    <span class="text-ink-faint">·</span>
    <span class="text-phosphor">free forever</span>
  </p>
</div>
<header class="sticky top-0 z-50 border-b border-line bg-bg/92 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/whisperflow/" aria-label="WhisperFlow home"><Logo class="h-6" /></a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          data-scramble={item.label}
          class:list={[
            "rounded-md px-3.5 py-1.5 font-mono text-[13px] transition-colors",
            path.startsWith(item.href)
              ? "bg-paper-2 text-phosphor"
              : "text-ink-dim hover:bg-paper/60 hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2.5">
      <button
        id="wf-mode-toggle"
        type="button"
        aria-label="Toggle light mode"
        class="hidden h-9 w-9 items-center justify-center rounded-md border border-line font-mono text-sm text-ink-dim transition-colors hover:border-phosphor hover:text-phosphor sm:flex"
        onclick="(()=>{const d=document.documentElement;const next=d.dataset.mode==='light'?'dark':'light';if(next==='light')d.dataset.mode='light';else delete d.dataset.mode;try{localStorage.setItem('wf-mode',next)}catch(e){}})()"
      >
        <span aria-hidden="true">☾</span>
      </button>
      <a href="/whisperflow/download/" class="btn btn-primary !px-4 !py-2 text-[13px]">get started</a>
    </div>
  </div>
</header>
