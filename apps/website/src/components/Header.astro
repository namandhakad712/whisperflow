---
import Logo from "./Logo.astro";

const nav = [
  { href: "/whisperflow/features/", label: "features" },
  { href: "/whisperflow/docs/", label: "docs" },
  { href: "/whisperflow/pricing/", label: "pricing" },
  { href: "/whisperflow/changelog/", label: "changelog" },
];
const path = Astro.url.pathname;
---
<header id="wf-header" class="sticky top-0 z-50 border-b border-rule-soft bg-paper/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/whisperflow/" aria-label="WhisperFlow home"><Logo class="h-6" /></a>

    <!-- desktop nav: scramble-decode on hover (the signature, see MOTION.md) -->
    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          data-scramble={item.label}
          class:list={[
            "wf-nav-link font-sans text-[14px] font-medium transition-colors",
            path.startsWith(item.href)
              ? "text-accent underline decoration-accent/40 underline-offset-8"
              : "text-ink-2 hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button
        id="wf-mode-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="hidden h-9 w-9 items-center justify-center rounded-sm border border-rule font-mono text-[13px] text-ink-2 transition-colors hover:border-accent hover:text-accent sm:flex"
        onclick="(()=>{const d=document.documentElement;const next=d.dataset.mode==='dark'?'light':'dark';if(next==='dark')d.dataset.mode='dark';else delete d.dataset.mode;try{localStorage.setItem('wf-mode',next)}catch(e){}})()"
      >
        <span aria-hidden="true">☾</span>
      </button>
      <a href="/whisperflow/download/" class="btn-ink !px-4 !py-2 !text-[13px] max-md:hidden">download</a>

      <!-- mobile: the menu switch -->
      <button
        id="wf-menu-open"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        class="flex h-9 w-9 items-center justify-center rounded-sm border border-rule text-ink-2 transition-colors hover:border-accent hover:text-accent md:hidden"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="17" x2="14" y2="17" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- the mobile menu: full-bleed sheet, mono index numbers, stagger-in -->
<div id="wf-menu" class="fixed inset-0 z-[60] hidden flex-col bg-paper md:hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="flex h-16 items-center justify-between border-b border-rule px-5">
    <a href="/whisperflow/" aria-label="WhisperFlow home" data-menu-close><Logo class="h-6" /></a>
    <button
      id="wf-menu-close"
      type="button"
      aria-label="Close menu"
      class="flex h-9 w-9 items-center justify-center rounded-sm border border-rule text-ink-2 transition-colors hover:border-accent hover:text-accent"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19" /><line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>
  </div>
  <nav class="flex flex-1 flex-col justify-center gap-1 px-6" aria-label="Main mobile">
    {nav.map((item, i) => (
      <a
        href={item.href}
        data-menu-close
        class:list={[
          "wf-menu-item group flex items-baseline gap-4 border-b border-rule py-4",
          path.startsWith(item.href) ? "text-accent" : "text-ink",
        ]}
        style={`--i:${i}`}
      >
        <span class="font-mono text-[11px] text-ink-faint">{String(i + 1).padStart(2, "0")}</span>
        <span class="font-serif text-4xl font-normal leading-none transition-colors group-hover:text-accent group-active:text-accent">{item.label}</span>
      </a>
    ))}
    <a href="/whisperflow/download/" data-menu-close class="wf-menu-item btn-ink mt-8 w-full text-center" style={`--i:${nav.length}`}>
      download for windows
    </a>
    <button
      id="wf-menu-theme"
      type="button"
      class="wf-menu-item mt-3 flex items-center justify-center gap-2 rounded-sm border border-rule py-3 font-mono text-[13px] text-ink-2"
      style={`--i:${nav.length + 1}`}
    >
      <span aria-hidden="true">☾</span> toggle dark mode
    </button>
  </nav>
  <p class="border-t border-rule px-6 py-4 font-mono text-[10px] uppercase tracking-[0.14em] text-ink-faint">
    local-first · apache-2.0 · no telemetry
  </p>
</div>

<script>
  // ---- the mobile sheet ----
  const sheet = document.getElementById("wf-menu")!;
  const openBtn = document.getElementById("wf-menu-open")!;
  const close = () => {
    sheet.classList.add("hidden");
    sheet.classList.remove("flex");
    openBtn.setAttribute("aria-expanded", "false");
    document.documentElement.style.overflow = "";
  };
  openBtn.addEventListener("click", () => {
    sheet.classList.remove("hidden");
    sheet.classList.add("flex");
    openBtn.setAttribute("aria-expanded", "true");
    document.documentElement.style.overflow = "hidden";
  });
  document.getElementById("wf-menu-close")!.addEventListener("click", close);
  sheet.querySelectorAll("[data-menu-close]").forEach((a) => a.addEventListener("click", close));
  document.getElementById("wf-menu-theme")!.addEventListener("click", () => {
    const d = document.documentElement;
    const next = d.dataset.mode === "dark" ? "light" : "dark";
    if (next === "dark") d.dataset.mode = "dark";
    else delete d.dataset.mode;
    try { localStorage.setItem("wf-mode", next); } catch (e) {}
  });

  // ---- scramble-decode: nav links cycle the glyph ramp on hover ----
  const RAMP = " .·:;=+x%#@";
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-scramble]").forEach((el) => {
    const text = el.dataset.scramble!;
    if (reduced) return;
    let raf = 0;
    let frame = 0;
    let running = false;
    const tick = () => {
      frame++;
      // settle left→right: `frame` glyphs decoded, the rest cycle the ramp
      const settled = Math.floor(frame / 2);
      let out = "";
      for (let i = 0; i < text.length; i++) {
        const ch = text[i]!;
        out += i < settled || ch === " " ? ch : (RAMP[Math.floor(Math.random() * RAMP.length)] ?? ch);
      }
      el.textContent = out;
      if (settled < text.length) raf = requestAnimationFrame(tick);
      else {
        el.textContent = text;
        running = false;
      }
    };
    const start = () => {
      if (running) return;
      running = true;
      frame = 0;
      raf = requestAnimationFrame(tick);
    };
    el.addEventListener("pointerenter", start);
    el.addEventListener("focus", start);
    el.addEventListener("pointerleave", () => {
      cancelAnimationFrame(raf);
      running = false;
      el.textContent = text;
    });
  });
</script>

<style>
  /* the sheet's items lay on staggered — out-expo, 60ms apart */
  @media (prefers-reduced-motion: no-preference) {
    .wf-menu-item {
      opacity: 0;
      transform: translateY(14px);
      animation: wf-menu-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(60ms * var(--i, 0));
    }
    @keyframes wf-menu-in {
      to { opacity: 1; transform: translateY(0); }
    }
  }
</style>
