---
import Logo from "./Logo.astro";

const nav = [
  { href: "/whisperflow/features/", label: "features" },
  { href: "/whisperflow/docs/", label: "docs" },
  { href: "/whisperflow/pricing/", label: "pricing" },
  { href: "/whisperflow/changelog/", label: "changelog" },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-line bg-bg">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/whisperflow/" aria-label="WhisperFlow home"><Logo class="h-6" /></a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          data-scramble={item.label}
          class:list={[
            "rounded-none px-3.5 py-1.5 font-mono text-[13px] transition-colors",
            path.startsWith(item.href)
              ? "bg-paper-2 text-phosphor shadow-[inset_0_-2px_0_var(--color-phosphor)]"
              : "text-ink-dim hover:bg-paper/60 hover:text-ink shadow-[inset_0_-1px_0_transparent] hover:shadow-[inset_0_-1px_0_var(--color-phosphor)]",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2.5">
      <button
        id="wf-mode-toggle"
        type="button"
        aria-label="Toggle light mode"
        class="hidden h-9 w-9 items-center justify-center rounded-none border border-line font-mono text-sm text-ink-dim transition-colors hover:border-phosphor hover:text-phosphor sm:flex"
        onclick="(()=>{const d=document.documentElement;const next=d.dataset.mode==='light'?'dark':'light';if(next==='light')d.dataset.mode='light';else delete d.dataset.mode;try{localStorage.setItem('wf-mode',next)}catch(e){}})()"
      >
        <span aria-hidden="true">☾</span>
      </button>
      <a href="/whisperflow/download/" class="btn btn-primary !px-4 !py-2 text-[13px]">get started</a>
    </div>
  </div>
</header>
