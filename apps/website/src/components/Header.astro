---
import Logo from "./Logo.astro";

const nav = [
  { href: "/whisperflow/features/", label: "features" },
  { href: "/whisperflow/docs/", label: "docs" },
  { href: "/whisperflow/pricing/", label: "pricing" },
  { href: "/whisperflow/changelog/", label: "changelog" },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-rule-soft bg-paper/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/whisperflow/" aria-label="WhisperFlow home"><Logo class="h-6" /></a>
    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "font-sans text-[14px] font-medium transition-colors",
            path.startsWith(item.href)
              ? "text-accent underline decoration-accent/40 underline-offset-8"
              : "text-ink-2 hover:text-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <button
        id="wf-mode-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="hidden h-9 w-9 items-center justify-center rounded-sm border border-rule font-mono text-[13px] text-ink-2 transition-colors hover:border-accent hover:text-accent sm:flex"
        onclick="(()=>{const d=document.documentElement;const next=d.dataset.mode==='dark'?'light':'dark';if(next==='dark')d.dataset.mode='dark';else delete d.dataset.mode;try{localStorage.setItem('wf-mode',next)}catch(e){}})()"
      >
        <span aria-hidden="true">☾</span>
      </button>
      <a href="/whisperflow/download/" class="btn-ink !px-4 !py-2 !text-[13px]">download</a>
    </div>
  </div>
</header>
