---
import Logo from "./Logo.astro";

const nav = [
  { href: "/whisperflow/features/", label: "Features" },
  { href: "/whisperflow/docs/", label: "Docs" },
  { href: "/whisperflow/pricing/", label: "Pricing" },
];
const path = Astro.url.pathname;
---
<div class="bg-forest text-center text-xs font-medium tracking-wide text-[#ffffeb]">
  <p class="mx-auto max-w-6xl px-4 py-2">
    <span class="sticker bg-coral text-[#ffffeb]">free forever</span>
    <span class="ml-2">Unlimited local dictation — no accounts, no word caps, no cloud.</span>
  </p>
</div>
<header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/whisperflow/" aria-label="WhisperFlow home"><Logo class="h-6" /></a>
    <nav class="hidden items-center gap-1 rounded-full border border-line bg-cream p-1 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-full px-4 py-1.5 text-sm font-medium transition-colors",
            path.startsWith(item.href) ? "bg-ink text-bg" : "hover:bg-ink/5",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button
        id="wf-mode-toggle"
        type="button"
        aria-label="Toggle light mode"
        class="hidden h-9 w-9 items-center justify-center rounded-full border border-line text-sm transition-colors hover:bg-white/10 sm:flex"
        onclick="(()=>{const d=document.documentElement;const next=d.dataset.mode==='light'?'dark':'light';if(next==='light')d.dataset.mode='light';else delete d.dataset.mode;try{localStorage.setItem('wf-mode',next)}catch(e){}})()"
      >
        ☾
      </button>
      <a href="/whisperflow/download/" class="btn-primary !py-2.5 text-sm">Get started on Windows</a>
    </div>
  </div>
</header>
