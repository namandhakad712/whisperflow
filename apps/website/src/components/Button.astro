---
interface Props {
  href: string;
  variant?: "primary" | "ghost" | "ink";
  class?: string;
}
const { href, variant = "primary", class: className = "" } = Astro.props;
---
<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-semibold transition-all hover:-translate-y-px",
    variant === "primary"
      ? "bg-lavender text-ink hover:bg-lavender-deep"
      : variant === "ink"
        ? "bg-ink text-bg hover:opacity-85"
        : "border border-ink text-ink hover:bg-ink/5",
    className,
  ]}
>
  <slot />
</a>
