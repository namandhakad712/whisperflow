---
/**
 * The WhisperFlow mark — a "W" drawn as a signal trace.
 * Original glyph for the Signal identity: a waveform that reads
 * as a W (and as /\/\ — the strokes of our glyph engines).
 */
interface Props { class?: string; mark?: boolean }
const { class: className = "h-6", mark = false } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg viewBox="0 0 28 24" class="h-full w-auto text-ink" aria-hidden="true" fill="none">
    <path
      d="M2 6 L7 18 L11 9 L14 20 L17 9 L21 18 L26 6"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {!mark && (
    <span class="font-serif text-[1.35rem] leading-none text-ink">
      WhisperFlow
    </span>
  )}
</span>
