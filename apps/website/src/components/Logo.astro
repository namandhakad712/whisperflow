---
/**
 * The WhisperFlow mark — a "W" drawn as a signal trace.
 * Original glyph for the Signal Standard identity: a waveform that reads
 * as a W (and as /\/\ — the character strokes of our ASCII engines).
 */
interface Props { class?: string; mark?: boolean }
const { class: className = "h-6", mark = false } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg viewBox="0 0 28 24" class="h-full w-auto text-phosphor" aria-hidden="true" fill="none">
    <path
      d="M2 6 L7 18 L11 9 L14 20 L17 9 L21 18 L26 6"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M2 6 L7 18 L11 9 L14 20 L17 9 L21 18 L26 6"
      stroke="currentColor"
      stroke-width="5.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.14"
    />
  </svg>
  {!mark && (
    <span class="font-mono text-[0.95rem] font-bold uppercase tracking-[0.18em] text-ink">
      WhisperFlow
    </span>
  )}
</span>
