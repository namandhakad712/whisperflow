---
interface Props { class?: string; mark?: boolean }
const { class: className = "h-6", mark = false } = Astro.props;
---
<span class:list={["inline-flex items-center gap-2", className]}>
  <svg viewBox="0 0 28 24" class="h-full w-auto" aria-hidden="true" fill="currentColor">
    <rect x="1"  y="9"  width="3.4" height="6"  rx="1.7" />
    <rect x="6.6" y="5" width="3.4" height="14" rx="1.7" />
    <rect x="12.2" y="1" width="3.4" height="22" rx="1.7" />
    <rect x="17.8" y="5" width="3.4" height="14" rx="1.7" />
    <rect x="23.4" y="9" width="3.4" height="6"  rx="1.7" />
  </svg>
  {!mark && <span class="text-[1.15rem] font-bold tracking-tight">WhisperFlow</span>}
</span>
