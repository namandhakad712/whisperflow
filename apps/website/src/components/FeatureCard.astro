---
interface Props { title: string; body: string; icon: string }
const { title, body, icon } = Astro.props;
const paths: Record<string, string> = {
  mic: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3ZM5 11a7 7 0 0 0 14 0M12 18v3",
  cpu: "M8 8h8v8H8zM4 9V7a3 3 0 0 1 3-3h2M20 9V7a3 3 0 0 0-3-3h-2M4 15v2a3 3 0 0 0 3 3h2M20 15v2a3 3 0 0 1-3 3h-2",
  book: "M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM19 19H6",
  slash: "M5 19 19 5M9 9a3 3 0 1 0 6 0 3 3 0 0 0-6 0Zm-4 6a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z",
  history: "M12 8v4l3 2M3 12a9 9 0 1 0 3-6.7M3 4v4h4",
  shield: "M12 3 5 6v5c0 4.4 3 8.4 7 10 4-1.6 7-5.6 7-10V6zM9.5 12l1.8 1.8 3.2-3.6",
  sliders: "M4 6h10M18 6h2M4 12h4M12 12h8M4 18h13M20 18h0M14 4v4M8 10v4M17 16v4",
  wand: "m5 19 9-9m0 0 3-3-2-2-3 3m2 2-2-2M18 13l1.5 1.5M15 4l.5 2M20 9l-2-.5",
};
---
<div class="card group p-6 transition-transform hover:-translate-y-0.5">
  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-forest text-[#ffffeb]">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
      <path d={paths[icon] ?? paths.mic} />
    </svg>
  </div>
  <h3 class="font-display mt-4 text-2xl">{title}</h3>
  <p class="mt-2 text-sm leading-6 text-ink-soft">{body}</p>
</div>
